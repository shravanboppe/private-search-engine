use_default_settings: true

general:
  debug: false
  instance_name: "Private Search Engine"

search:
  safe_search: 2
  autocomplete: 'duckduckgo'
  formats:
    - html
    - json

server:
  secret_key: "REPLACE_WITH_A_PRIVATE_RANDOM_SECRET"
  limiter: false
  image_proxy: true

valkey:
  url: valkey://valkey:6379/0
